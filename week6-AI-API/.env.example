# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Provider (pick one lane) ---
# OpenRouter (hosted, free tier, no local disk needed):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-key-here
LLM_MODEL=openrouter/free

# Ollama (local, unlimited, needs ~1GB disk):
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama
# LLM_MODEL=gemma3:1b

# --- Dev / safety switches ---
# 1 = skip the model entirely, return a hard-coded schema-valid response
LLM_STUB=0
# false = kill switch: skip the model, return a deterministic fallback
LLM_ENABLED=true
